{
  "name": "terratrack",
  "version": "0.1.0",
  "description": "Road trips composés par IA : quelques questions, un itinéraire logique sans allers-retours, de vrais lieux, sur un globe 3D.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "reseau": "TERRATRACK_HOTE=0.0.0.0 vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "terrain": "vite --config terrain/vite.config.js",
    "terrain:build": "vite build --config terrain/vite.config.js",
    "terrain:preview": "vite preview --config terrain/vite.config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@protomaps/basemaps": "^5.7.2",
    "cesium": "1.138.0",
    "maplibre-gl": "^6.15.0",
    "pmtiles": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "6.4.3",
    "vite-plugin-cesium": "1.2.23"
  },
  "overrides": {
    "@cesium/engine": "22.3.0",
    "@cesium/widgets": "14.3.0"
  }
